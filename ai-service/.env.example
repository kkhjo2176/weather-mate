# Copy to .env and supply a random key of at least 16 characters.
# Reuse local-api.key if Spring Boot already uses that key.
# .env and local-api.key are excluded from Git and Docker images.
PANGU_API_KEY=
PANGU_API_PORT=8000

# Optional: use the same result/model directories as your local GPU updater.
# On Windows use forward slashes, for example C:/weather/ai-service/data.
# PANGU_HOST_DATA_DIR=./data
# PANGU_HOST_MODELS_DIR=./models
